# This file is a reference only; the application does not load .env files.
# For local development, DEBUG=true uses an ephemeral development key if
# SECRET_KEY is unset. Supply a local-only key through the environment if needed.
# Production must receive SECRET_KEY from a deployment secret store.
# Set environment variables in your shell/deployment platform; do not commit secrets.
# Local development may leave SECRET_KEY unset (the key is ephemeral).
# Production must set a unique, strong SECRET_KEY.
# SECRET_KEY=<deployment-secret>
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Comma-separated full origins, including scheme, e.g. https://example.com.
# Leave empty for local development unless cross-origin POSTs require it.
CSRF_TRUSTED_ORIGINS=

# Production example (set real values in the deployment environment):
# DEBUG=false
# ALLOWED_HOSTS=example.com,www.example.com
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# Enable HSTS only after confirming HTTPS is reliable for the full domain scope.
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# Local default is console email; production defaults to SMTP on port 587 with TLS.
# Set production mail server details and credentials in the deployment environment.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=<smtp-host>
# EMAIL_PORT=587
# EMAIL_HOST_USER=<smtp-username>
# EMAIL_HOST_PASSWORD=<deployment-provided>
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# DEFAULT_FROM_EMAIL=<verified-sender-address>
